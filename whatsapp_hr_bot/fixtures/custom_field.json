[
 {
  "doctype": "Custom Field",
  "name": "WhatsApp Message-custom_notification_event",
  "dt": "WhatsApp Message",
  "fieldname": "custom_notification_event",
  "label": "Notification Event",
  "fieldtype": "Data",
  "insert_after": "status",
  "read_only": 1,
  "no_copy": 1,
  "in_standard_filter": 1,
  "description": "Which configured rule/outcome sent this message, e.g. \"submitted\", \"approved\"."
 },
 {
  "doctype": "Custom Field",
  "name": "WhatsApp Message-custom_recipient_doctype",
  "dt": "WhatsApp Message",
  "fieldname": "custom_recipient_doctype",
  "label": "Recipient DocType",
  "fieldtype": "Link",
  "options": "DocType",
  "insert_after": "custom_notification_event",
  "read_only": 1,
  "no_copy": 1
 },
 {
  "doctype": "Custom Field",
  "name": "WhatsApp Message-custom_recipient",
  "dt": "WhatsApp Message",
  "fieldname": "custom_recipient",
  "label": "Recipient",
  "fieldtype": "Dynamic Link",
  "options": "custom_recipient_doctype",
  "insert_after": "custom_recipient_doctype",
  "read_only": 1,
  "no_copy": 1
 },
 {
  "doctype": "Custom Field",
  "name": "WhatsApp Message-custom_recipient_name",
  "dt": "WhatsApp Message",
  "fieldname": "custom_recipient_name",
  "label": "Recipient Name",
  "fieldtype": "Data",
  "insert_after": "custom_recipient",
  "read_only": 1,
  "no_copy": 1,
  "in_list_view": 1,
  "in_standard_filter": 1
 },
 {
  "doctype": "Custom Field",
  "name": "WhatsApp Message-custom_sent_at",
  "dt": "WhatsApp Message",
  "fieldname": "custom_sent_at",
  "label": "Sent At",
  "fieldtype": "Datetime",
  "insert_after": "custom_recipient_name",
  "read_only": 1,
  "no_copy": 1,
  "in_list_view": 1
 },
 {
  "doctype": "Custom Field",
  "name": "WhatsApp Message-custom_error",
  "dt": "WhatsApp Message",
  "fieldname": "custom_error",
  "label": "Error / Response",
  "fieldtype": "Small Text",
  "insert_after": "custom_sent_at",
  "read_only": 1,
  "no_copy": 1
 },
 {
  "doctype": "Custom Field",
  "name": "Employee-custom_whatsapp_notification_preferences",
  "dt": "Employee",
  "fieldname": "custom_whatsapp_notification_preferences",
  "label": "WhatsApp Notification Preferences",
  "fieldtype": "Section Break",
  "insert_after": "contact_details"
 },
 {
  "doctype": "Custom Field",
  "name": "Employee-custom_whatsapp_apply_leave",
  "dt": "Employee",
  "fieldname": "custom_whatsapp_apply_leave",
  "label": "Apply Leave",
  "fieldtype": "Check",
  "default": "1",
  "insert_after": "custom_whatsapp_notification_preferences"
 },
 {
  "doctype": "Custom Field",
  "name": "Employee-custom_whatsapp_leave_balance",
  "dt": "Employee",
  "fieldname": "custom_whatsapp_leave_balance",
  "label": "Leave Balance",
  "fieldtype": "Check",
  "default": "1",
  "insert_after": "custom_whatsapp_apply_leave"
 },
 {
  "doctype": "Custom Field",
  "name": "Employee-custom_whatsapp_my_requests",
  "dt": "Employee",
  "fieldname": "custom_whatsapp_my_requests",
  "label": "My Requests",
  "fieldtype": "Check",
  "default": "1",
  "insert_after": "custom_whatsapp_leave_balance"
 },
 {
  "doctype": "Custom Field",
  "name": "Employee-custom_whatsapp_my_onboarding",
  "dt": "Employee",
  "fieldname": "custom_whatsapp_my_onboarding",
  "label": "My Onboarding",
  "fieldtype": "Check",
  "default": "1",
  "insert_after": "custom_whatsapp_my_requests"
 },
 {
  "doctype": "Custom Field",
  "name": "Employee-custom_whatsapp_expense_claim",
  "dt": "Employee",
  "fieldname": "custom_whatsapp_expense_claim",
  "label": "Expense Claim",
  "fieldtype": "Check",
  "default": "1",
  "insert_after": "custom_whatsapp_my_onboarding",
  "description": "Gates the inbound chatbot's \"Expense Claim Status\" menu option (whatsapp_handler.py), not the outbound Finance alerts below."
 },
 {
  "doctype": "Custom Field",
  "name": "Employee-custom_whatsapp_notification_categories",
  "dt": "Employee",
  "fieldname": "custom_whatsapp_notification_categories",
  "label": "WhatsApp Notification Categories",
  "fieldtype": "Section Break",
  "insert_after": "custom_whatsapp_expense_claim",
  "description": "Which categories of *outbound* WhatsApp alerts (notify/config.py rules triggered by document events, e.g. Expense Claim approval) this employee receives. Unrelated to the chatbot menu checkboxes above, which control what the inbound WhatsApp bot's own menu offers."
 },
 {
  "doctype": "Custom Field",
  "name": "Employee-custom_whatsapp_leave",
  "dt": "Employee",
  "fieldname": "custom_whatsapp_leave",
  "label": "Leave",
  "fieldtype": "Check",
  "default": "1",
  "insert_after": "custom_whatsapp_notification_categories"
 },
 {
  "doctype": "Custom Field",
  "name": "Employee-custom_whatsapp_onboarding",
  "dt": "Employee",
  "fieldname": "custom_whatsapp_onboarding",
  "label": "Onboarding",
  "fieldtype": "Check",
  "default": "1",
  "insert_after": "custom_whatsapp_leave"
 },
 {
  "doctype": "Custom Field",
  "name": "Employee-custom_whatsapp_attendance",
  "dt": "Employee",
  "fieldname": "custom_whatsapp_attendance",
  "label": "Attendance",
  "fieldtype": "Check",
  "default": "1",
  "insert_after": "custom_whatsapp_onboarding"
 },
 {
  "doctype": "Custom Field",
  "name": "Employee-custom_whatsapp_finance",
  "dt": "Employee",
  "fieldname": "custom_whatsapp_finance",
  "label": "Finance",
  "fieldtype": "Check",
  "default": "1",
  "insert_after": "custom_whatsapp_attendance",
  "description": "Gates the Expense Claim approved/rejected WhatsApp notifications (notify/config.py)."
 },
 {
  "doctype": "Custom Field",
  "name": "Employee-custom_whatsapp_hr_announcements",
  "dt": "Employee",
  "fieldname": "custom_whatsapp_hr_announcements",
  "label": "HR Announcements",
  "fieldtype": "Check",
  "default": "1",
  "insert_after": "custom_whatsapp_finance"
 }
]
